{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/spec/0.1/composition.schema.json",
  "title": "Composition manifest 0.1",
  "type": "object",
  "required": [
    "spec",
    "id",
    "version",
    "name",
    "license",
    "credits",
    "ai_assisted",
    "tools",
    "items"
  ],
  "additionalProperties": false,
  "patternProperties": { "^x-": {} },
  "properties": {
    "spec": { "const": "0.1" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "license": { "const": "CC0-1.0" },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "credits": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/credit" }
    },
    "ai_assisted": { "type": "boolean" },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "source_url": { "type": ["string", "null"], "format": "uri" },
    "notes_url": { "type": ["string", "null"], "format": "uri" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 104,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "pinned": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?/[a-z0-9]+(?:-[a-z0-9]+)*@[1-9][0-9]*$"
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset", "position", "rotation"],
      "properties": {
        "asset": { "$ref": "#/$defs/pinned" },
        "position": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" }
        },
        "rotation": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        },
        "scale": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "credit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles"],
      "anyOf": [{ "required": ["github"] }, { "required": ["name"] }],
      "properties": {
        "github": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["directed", "modeled", "sculpted", "textured", "coded", "scanned"] }
        }
      }
    }
  }
}
